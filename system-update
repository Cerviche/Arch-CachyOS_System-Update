# Read orphan packages from pacman
read_orphans() {
    local output_file=$1
    local error_file=$2
    local rc

    : >"$output_file"
    : >"$error_file"

    pacman -Qdtq >"$output_file" 2>"$error_file"
    rc=$?

    case "$rc" in
        0)
            # One or more orphaned packages found.
            return 0
            ;;
        1)
            # No orphaned packages. This is a normal condition.
            if [[ ! -s "$output_file" && ! -s "$error_file" ]]; then
                return 0
            fi
            # Exit 1 with stderr means a genuine query failure.
            return 1
            ;;
        *)
            return "$rc"
            ;;
    esac
}

# Handle orphan package removal interactively
handle_orphans() {
    section "Orphans"

    local output_file="$TEMP_DIR/orphans.txt"
    local error_file="$TEMP_DIR/orphans.err"
    local -a orphans=()
    local current_count=0
    local prior_signature=""
    local signature=""

    while true; do
        if ! read_orphans "$output_file" "$error_file"; then
            error "orphans.query" "Unable to query orphaned packages."
            indent_file "$error_file"
            return
        fi

        mapfile -t orphans < <(awk 'NF {print $1}' "$output_file")
        current_count=${#orphans[@]}

        if (( current_count == 0 )); then
            if (( ORPHANS_FOUND == 0 )); then
                ok "No orphaned packages were found."
            else
                ok "No orphaned packages remain."
            fi
            return
        fi

        if (( ORPHANS_FOUND == 0 )); then
            ORPHANS_FOUND=$current_count
        fi

        info "Orphaned packages:"
        printf '    %s\n' "${orphans[@]}"
        info "Build dependencies can legitimately appear in this list."

        if ! ask_yes_no "Remove these orphaned packages? [y/N] "; then
            ORPHAN_REMOVAL_DECLINED="yes"
            info "Orphaned packages were left installed."
            return
        fi

        if ! check_pacman_lock "orphan-removal"; then
            return
        fi

        if sudo pacman -Rns --noconfirm -- "${orphans[@]}"; then
            ORPHANS_REMOVED=$(( ORPHANS_REMOVED + current_count ))
            ok "Removed $current_count orphaned package(s)."
        else
            error "orphans.remove" "Orphan removal failed."
            return
        fi

        # Break if we're making no progress (prevent infinite loops)
        signature=$(printf '%s\n' "${orphans[@]}")
        if [[ "$signature" == "$prior_signature" ]]; then
            error "orphans.no_progress" \
                "Orphan removal made no observable progress; stopping the loop."
            return
        fi
        prior_signature=$signature
    done
}

# Clean pacman package cache
clean_pacman_cache() {
    section "Package cache"

    if [[ "${HAVE[paccache]:-0}" != "1" ]]; then
        warn "cache.paccache.missing" \
            "paccache is unavailable; pacman-contrib provides it. No cache fallback will be used."
        return
    fi

    # Keep newest 3 versions of installed packages
    if sudo paccache -r -k 3; then
        ok "Kept the newest three cached versions of installed packages."
    else
        warn "cache.installed" \
            "Cleaning old cached versions of installed packages failed."
    fi

    # Remove cached packages that are no longer installed
    if sudo paccache -ruk0; then
        ok "Removed cached packages that are no longer installed."
    else
        warn "cache.uninstalled" \
            "Cleaning cached packages that are no longer installed failed."
    fi
}

# -----------------------------------------------------------------------------
# Post-update health checks
# -----------------------------------------------------------------------------

# Check if reboot is required after updates
check_restart_requirement() {
    section "Restart check"

    if [[ -n "$RUNNING_KERNEL_PACKAGE" ]]; then
        RUNNING_KERNEL_VERSION_AFTER=$(
            pacman -Q -- "$RUNNING_KERNEL_PACKAGE" 2>/dev/null |
                awk 'NF >= 2 {print $2; exit}'
        )

        if [[ -z "$RUNNING_KERNEL_VERSION_AFTER" ]]; then
            REBOOT_REQUIRED="yes"
            warn "kernel.package.removed" \
                "The package that owns the running kernel is no longer installed."
        elif [[ "$RUNNING_KERNEL_VERSION_AFTER" != "$RUNNING_KERNEL_VERSION_BEFORE" ]]; then
            REBOOT_REQUIRED="yes"
            warn "kernel.package.changed" \
                "The running kernel package changed from ${RUNNING_KERNEL_VERSION_BEFORE:-unknown} to $RUNNING_KERNEL_VERSION_AFTER."
        fi
    fi

    if [[ -n "$RUNNING_MODULE_DIR" && ! -d "$RUNNING_MODULE_DIR" ]]; then
        REBOOT_REQUIRED="yes"
        warn "kernel.modules.missing" \
            "The module directory for the running kernel is absent."
    fi

    if [[ "$REBOOT_REQUIRED" == "yes" ]]; then
        warn "reboot.required" "A reboot is required; no reboot will be performed."
    else
        ok "No kernel-based reboot requirement was detected."
    fi
}

# Rescan health after updates
rescan_post_update_health() {
    section "Post-update health rescan"
    scan_config_files "yes"
    scan_failed_units "yes"
}

# Prompt to read Arch Linux news
prompt_read_news() {
    [[ "$MODE" == "update" ]] || return
    (( NEWS_CHECK_OK == 1 )) || return
    [[ "$UNREAD_NEWS_COUNT" =~ ^[0-9]+$ ]] || return
    (( UNREAD_NEWS_COUNT > 0 )) || return

    section "Arch Linux news choice"

    if ask_yes_no "Read $UNREAD_NEWS_COUNT unread Arch Linux news item(s) now? [y/N] "; then
        if sudo informant read; then
            ok "Informant news reading completed."
            # Check how many remain unread
            if sudo -n informant list --unread > "$TEMP_DIR/informant-unread-after.txt" \
                2> "$TEMP_DIR/informant-unread-after.err"; then
                UNREAD_NEWS_COUNT=$(
                    count_nonempty_lines "$TEMP_DIR/informant-unread-after.txt"
                )
            fi
        else
            error "informant.read" "Informant could not complete news reading."
        fi
    else
        NEWS_READ_DECLINED="yes"
        info "Unread Arch Linux news items were left unread."
    fi
}

# -----------------------------------------------------------------------------
# Summary and exit functions
# -----------------------------------------------------------------------------

# Format a summary value
summary_value() {
    printf '%-42s %s\n' "$1:" "$2"
}

# Print collected messages
print_messages() {
    local heading=$1
    shift
    local -a messages=("$@")
    local message

    (( ${#messages[@]} > 0 )) || return
    printf '\n%s:\n' "$heading"
    for message in "${messages[@]}"; do
        printf '    - %s\n' "$message"
    done
}

# Print the final summary
print_summary() {
    local end_epoch
    local duration
    local warning_count=${#WARNING_MESSAGES[@]}
    local error_count=${#ERROR_MESSAGES[@]}

    end_epoch=$(date +%s)
    duration=$(( end_epoch - START_EPOCH ))

    section "Summary"

    if [[ "$MODE" == "update" ]]; then
        summary_value "Repository transaction" "$REPO_TRANSACTION_STATUS"
        summary_value "Repository updates initially detected" "$REPO_UPDATES_COUNT"
        summary_value "AUR transaction" "$AUR_TRANSACTION_STATUS"
        summary_value "AUR updates initially detected" "$AUR_UPDATES_COUNT"
        summary_value "System Flatpak transaction" "$FLATPAK_SYSTEM_TRANSACTION_STATUS"
        summary_value "User Flatpak transaction" "$FLATPAK_USER_TRANSACTION_STATUS"
        summary_value "Orphans found" "$ORPHANS_FOUND"
        summary_value "Orphans removed" "$ORPHANS_REMOVED"
        summary_value "Orphan removal declined" "$ORPHAN_REMOVAL_DECLINED"
        summary_value "Configuration files pending" "$CONFIG_TOTAL_COUNT"
        summary_value "High-priority configuration files" "$CONFIG_HIGH_COUNT"
        summary_value "Relevant failed units" "$RELEVANT_FAILED_COUNT"
        summary_value "Ignored failed units" "$IGNORED_FAILED_COUNT"
        summary_value "Unread Arch news" "$UNREAD_NEWS_COUNT"
        summary_value "News reading declined" "$NEWS_READ_DECLINED"
        summary_value "Reboot required" "$REBOOT_REQUIRED"
    else
        summary_value "Repository updates available" "$REPO_UPDATES_COUNT"
        summary_value "AUR updates available" "$AUR_UPDATES_COUNT"
        summary_value "System Flatpak updates available" "$FLATPAK_SYSTEM_UPDATES_COUNT"
        summary_value "User Flatpak updates available" "$FLATPAK_USER_UPDATES_COUNT"
        summary_value "High-priority configuration files" "$CONFIG_HIGH_COUNT"
        summary_value "Total configuration files" "$CONFIG_TOTAL_COUNT"
        summary_value "Relevant failed units" "$RELEVANT_FAILED_COUNT"
        summary_value "Ignored failed units" "$IGNORED_FAILED_COUNT"
        summary_value "Unread Arch news" "$UNREAD_NEWS_COUNT"
        summary_value "Reboot required" "$REBOOT_REQUIRED"
    fi

    summary_value "Warnings" "$warning_count"
    summary_value "Errors" "$error_count"
    summary_value "Duration" "${duration}s"

    print_messages "Warnings" "${WARNING_MESSAGES[@]}"
    print_messages "Errors" "${ERROR_MESSAGES[@]}"
}

# Determine final exit status
final_exit_status() {
    if (( ${#ERROR_MESSAGES[@]} > 0 )); then
        return 1
    fi
    return 0
}

# -----------------------------------------------------------------------------
# Main execution modes
# -----------------------------------------------------------------------------

# Run read-only mode (audit or plan)
run_read_only_mode() {
    run_full_audit
    if (( REQUIRED_MISSING == 0 )); then
        check_arch_news
        discover_updates
        check_restart_requirement
        if [[ "$MODE" == "plan" ]]; then
            print_update_plan
        fi
    fi
    print_summary
    final_exit_status
}

# Run update mode
run_update_mode() {
    local repository_ok=0

    # Audit before updates
    run_full_audit
    if (( REQUIRED_MISSING == 0 )); then
        check_arch_news
        discover_updates
    fi

    # Block if audit failed
    if (( BLOCKING_FAILURES > 0 || REQUIRED_MISSING != 0 )); then
        REPO_TRANSACTION_STATUS="blocked by audit"
        AUR_TRANSACTION_STATUS="blocked by audit"
        FLATPAK_SYSTEM_TRANSACTION_STATUS="blocked by audit"
        FLATPAK_USER_TRANSACTION_STATUS="blocked by audit"
        error "update.blocked" \
            "Package changes were aborted because the safety audit has blocking failures."
        check_restart_requirement
        prompt_read_news
        print_summary
        final_exit_status
        return
    fi

    # Temporarily disable Informant hooks
    mask_informant_hooks || true

    # Run repository update
    if run_official_update; then
        repository_ok=1
        # Re-disable Informant hooks (may have been reinstalled by pacman)
        mask_informant_hooks || true
        run_aur_update
        # Re-disable Informant hooks again (AUR update may have changed them)
        mask_informant_hooks || true
    else
        AUR_TRANSACTION_STATUS="skipped after repository failure"
        warn "transaction.aur.skipped" \
            "AUR update was skipped because the repository transaction failed."
    fi

    # Run Flatpak updates
    run_flatpak_updates

    # Maintenance tasks only if repository update succeeded
    if (( repository_ok == 1 )); then
        handle_orphans
        clean_pacman_cache
    else
        info "Pacman orphan and cache maintenance were skipped after repository failure."
    fi

    # Restore Informant hooks
    if ! restore_informant_hooks "no"; then
        error "informant.hook.restore" \
            "One or more Informant hook overrides could not be restored."
    fi

    # Post-update checks
    rescan_post_update_health
    check_restart_requirement
    prompt_read_news
    print_summary
    final_exit_status
}

# -----------------------------------------------------------------------------
# Script entry point
# -----------------------------------------------------------------------------

main() {
    local parse_rc=0

    START_EPOCH=$(date +%s)
    init_output

    # Parse command line arguments
    parse_args "$@" || parse_rc=$?
    if (( parse_rc != 0 )); then
        return "$parse_rc"
    fi

    # Ensure script is not run as root
    if (( EUID == 0 )); then
        printf '[FAIL] %s must be run as a normal user, never directly as root.\n' \
            "$SCRIPT_NAME" >&2
        return 1
    fi

    # Handle help and version modes early
    case "$MODE" in
        help)
            usage
            return 0
            ;;
        version)
            version
            return 0
            ;;
    esac

    # Ensure required utilities are available
    if ! command -v flock >/dev/null 2>&1; then
        printf '[FAIL] Required command is missing: flock\n' >&2
        return 1
    fi
    if ! command -v mktemp >/dev/null 2>&1; then
        printf '[FAIL] Required base command is missing: mktemp\n' >&2
        return 1
    fi

    # Acquire lock and set up environment
    acquire_lock || return 1
    create_temp_dir || return 1
    install_traps
    print_header

    # Acquire sudo credentials
    if ! authorize_sudo; then
        print_summary
        return 1
    fi

    # Execute requested mode
    case "$MODE" in
        audit|plan)
            run_read_only_mode
            ;;
        update)
            run_update_mode
            ;;
    esac
}

# Invoke main with all arguments
main "$@"
