# Prompt for yes/no answer
ask_yes_no() {
    local prompt=$1
    local answer=""

    printf '%s' "$prompt"
    if ! IFS= read -r answer; then
        printf '\n'
        return 1
    fi

    case "$answer" in
        y|Y|yes|YES|Yes)
            return 0
            ;;
    esac
    return 1
}

