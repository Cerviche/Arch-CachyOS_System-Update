# Determine if a configuration file is high priority
is_high_priority_config() {
    local base=$1

    case "$base" in
        /etc/pacman.conf|\
        /etc/makepkg.conf|\
        /etc/mkinitcpio.conf|\
        /etc/fstab|\
        /etc/crypttab|\
        /etc/default/grub|\
        /etc/limine-entry-tool.conf|\
        /etc/sudoers|\
        /etc/passwd|\
        /etc/group|\
        /etc/shadow|\
        /etc/gshadow|\
        /etc/nsswitch.conf|\
        /etc/locale.conf|\
        /etc/locale.gen|\
        /etc/hostname|\
        /etc/hosts|\
        /etc/resolv.conf|\
        /etc/ssh/sshd_config)
            return 0
            ;;
    esac
    return 1
}

# Scan for pending pacnew/pacsave/pacorig files
scan_config_files() {
    local report=${1:-yes}
    local found_file="$TEMP_DIR/config-files.txt"
    local scan_error="$TEMP_DIR/config-files.err"
    local path
    local base
    local pacdiff_rc=0
    declare -A seen=()

    CONFIG_HIGH_FILES=()
    CONFIG_NORMAL_FILES=()
    : > "$found_file"
    : > "$scan_error"

    # Use pacdiff if available
    if [[ "${HAVE[pacdiff]:-0}" == "1" ]]; then
        pacdiff -o > "$found_file" 2> "$scan_error" || pacdiff_rc=$?
        if (( pacdiff_rc != 0 )); then
            warn "config.pacdiff" \
                "pacdiff -o failed; falling back to a read-only search under /etc."
            : > "$found_file"
            sudo -n find /etc -xdev -type f \
                \( -name '*.pacnew' -o -name '*.pacsave' -o -name '*.pacorig' \) \
                -print > "$found_file" 2>> "$scan_error" || true
        fi
    else
        sudo -n find /etc -xdev -type f \
            \( -name '*.pacnew' -o -name '*.pacsave' -o -name '*.pacorig' \) \
            -print > "$found_file" 2> "$scan_error" || true
    fi

    # Process found files
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        if [[ "$path" != /* ]]; then
            path="/${path}"
        fi
        [[ -z "${seen[$path]+x}" ]] || continue
        seen["$path"]=1

        base=$path
        base=${base%.pacnew}
        base=${base%.pacsave}
        base=${base%.pacorig}

        if is_high_priority_config "$base"; then
            CONFIG_HIGH_FILES+=("$path")
        else
            CONFIG_NORMAL_FILES+=("$path")
        fi
    done < "$found_file"

    CONFIG_HIGH_COUNT=${#CONFIG_HIGH_FILES[@]}
    CONFIG_TOTAL_COUNT=$(( CONFIG_HIGH_COUNT + ${#CONFIG_NORMAL_FILES[@]} ))

    # Report findings
    if (( CONFIG_TOTAL_COUNT == 0 )); then
        ok "No pacnew, pacsave, or pacorig files were found."
    else
        warn "config.pending" \
            "$CONFIG_TOTAL_COUNT package configuration file(s) require manual review."
        if (( CONFIG_HIGH_COUNT > 0 )); then
            warn "config.high_priority" \
                "$CONFIG_HIGH_COUNT high-priority package configuration file(s) require manual review."
        fi
        if [[ -n "${seen[/etc/pacman.conf.pacnew]+x}" ]]; then
            warn "config.pacman_conf.pacnew" \
                "/etc/pacman.conf.pacnew is pending; active repository checks determine whether the current configuration is usable."
        fi
    fi

    # Print detailed list if requested and files exist
    if [[ "$report" == "yes" && $CONFIG_TOTAL_COUNT -gt 0 ]]; then
        if (( CONFIG_HIGH_COUNT > 0 )); then
            info "High-priority configuration files:"
            printf '    %s\n' "${CONFIG_HIGH_FILES[@]}"
        fi
        if (( ${#CONFIG_NORMAL_FILES[@]} > 0 )); then
            info "Normal-priority configuration files:"
            printf '    %s\n' "${CONFIG_NORMAL_FILES[@]}"
        fi
    fi

    if [[ -s "$scan_error" ]]; then
        info "Configuration scan diagnostics:"
        indent_file "$scan_error"
    fi
}

# Audit configuration files
audit_config_files() {
    section "Configuration files"
    scan_config_files "yes"
}

# Scan for failed systemd units
scan_failed_units() {
    local report=${1:-yes}
    local failed_file="$TEMP_DIR/failed-units.txt"
    local failed_error="$TEMP_DIR/failed-units.err"
    local unit
    local unit_state
    local load_state

    RELEVANT_FAILED_UNITS=()
    IGNORED_FAILED_UNITS=()
    : > "$failed_file"
    : > "$failed_error"

    # Query failed units
    if ! systemctl list-units --state=failed --all --no-legend --plain \
        > "$failed_file" 2> "$failed_error"; then
        warn "systemd.query" "Unable to query failed systemd units."
        indent_file "$failed_error"
        RELEVANT_FAILED_COUNT=0
        IGNORED_FAILED_COUNT=0
        return
    fi

    # Classify each failed unit
    while IFS= read -r unit; do
        [[ -n "$unit" ]] || continue

        unit_state=$(systemctl is-enabled "$unit" 2>/dev/null || true)
        unit_state=${unit_state%%$'\n'*}
        load_state=$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)

        case "$unit_state" in
            disabled|masked|masked-runtime)
                IGNORED_FAILED_UNITS+=("$unit [$unit_state]")
                ;;
            *)
                if [[ "$load_state" == "not-found" ]]; then
                    IGNORED_FAILED_UNITS+=("$unit [not-found]")
                else
                    RELEVANT_FAILED_UNITS+=("$unit [${unit_state:-unknown}]")
                fi
                ;;
        esac
    done < <(
        awk '
            {
                for (i = 1; i <= NF; i++) {
                    if ($i ~ /\.(service|socket|target|device|mount|automount|swap|timer|path|slice|scope|busname)$/) {
                        print $i
                        break
                    }
                }
            }
        ' "$failed_file"
    )

    RELEVANT_FAILED_COUNT=${#RELEVANT_FAILED_UNITS[@]}
    IGNORED_FAILED_COUNT=${#IGNORED_FAILED_UNITS[@]}

    if (( RELEVANT_FAILED_COUNT > 0 )); then
        warn "systemd.failed.relevant" \
            "$RELEVANT_FAILED_COUNT operationally relevant systemd unit(s) are failed."
    else
        ok "No operationally relevant failed systemd units were found."
    fi

    if (( IGNORED_FAILED_COUNT > 0 )); then
        info "$IGNORED_FAILED_COUNT disabled, masked, or stale failed unit(s) were ignored."
    else
        info "No disabled, masked, or stale failed unit remnants were found."
    fi

    if [[ "$report" == "yes" ]]; then
        if (( RELEVANT_FAILED_COUNT > 0 )); then
            info "Relevant failed units:"
            printf '    %s\n' "${RELEVANT_FAILED_UNITS[@]}"
        fi
        if (( IGNORED_FAILED_COUNT > 0 )); then
            info "Ignored failed units:"
            printf '    %s\n' "${IGNORED_FAILED_UNITS[@]}"
        fi
    fi
}

# Audit system services
audit_system_services() {
    section "System services"
    scan_failed_units "yes"
}

