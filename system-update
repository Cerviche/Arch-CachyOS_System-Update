# Run official repository update
run_official_update() {
    section "Official repository update"

    if ! check_pacman_lock "repository-transaction"; then
        REPO_TRANSACTION_STATUS="blocked by pacman lock"
        return 1
    fi

    info "Running official repository transaction with pacman."
    if sudo pacman -Syu --noconfirm; then
        REPO_TRANSACTION_STATUS="completed"
        ok "Repository transaction completed."
        return 0
    fi

    REPO_TRANSACTION_STATUS="failed"
    error "transaction.repository" \
        "Repository transaction failed; the AUR transaction and pacman maintenance will be skipped."
    return 1
}

# Run AUR update
run_aur_update() {
    section "AUR update"

    local -a devel_args=()
    local -a yay_args=(
        -Sua
        --noconfirm
        --answerclean None
        --answerdiff None
        --answeredit None
        --answerupgrade All
    )
    local rc=0

    if [[ "$AUR_CHECK_DEVEL" == "true" ]]; then
        devel_args=(--devel)
    else
        devel_args=(--devel=false)
    fi

    if (( AUR_DISCOVERY_OK != 1 )); then
        AUR_TRANSACTION_STATUS="skipped; discovery failed"
        warn "transaction.aur.discovery" \
            "AUR update was skipped because AUR discovery did not complete."
        return
    fi

    if [[ "$AUR_UPDATES_COUNT" == "0" ]]; then
        AUR_TRANSACTION_STATUS="not needed"
        info "No AUR updates were detected."
        return
    fi

    if ! check_pacman_lock "aur-transaction"; then
        AUR_TRANSACTION_STATUS="blocked by pacman lock"
        return
    fi

    info "Running AUR-only transaction with Yay."

    if yay "${yay_args[@]}" "${devel_args[@]}"; then
        AUR_TRANSACTION_STATUS="completed"
        ok "AUR transaction completed."
    else
        rc=$?
        AUR_TRANSACTION_STATUS="failed"
        error "transaction.aur" \
            "AUR transaction failed or required intervention (exit status $rc)."
    fi
}

# Update Flatpak scope (system or user)
update_flatpak_scope() {
    local scope=$1
    local label=$2
    local has_refs=$3
    local status_var=$4
    local -a cmd=(flatpak)

    if [[ "$scope" == "--system" ]]; then
        cmd=(sudo flatpak)
    fi

    if (( has_refs == 0 )); then
        printf -v "$status_var" '%s' "not applicable; no refs"
        info "No $label Flatpak refs are installed."
        return
    fi

    info "Updating $label Flatpaks."
    if "${cmd[@]}" update "$scope" --noninteractive -y; then
        printf -v "$status_var" '%s' "completed"
        ok "$label Flatpak update completed."

        # Remove unused runtimes
        if "${cmd[@]}" uninstall "$scope" --unused --noninteractive -y; then
            ok "Unused $label Flatpak runtimes were processed."
        else
            warn "flatpak.${label}.unused" \
                "Unused $label Flatpak runtime removal failed."
        fi
    else
        printf -v "$status_var" '%s' "failed"
        error "transaction.flatpak.${label}" "$label Flatpak update failed."
    fi
}

# Run all Flatpak updates
run_flatpak_updates() {
    section "Flatpak"

    if [[ "${HAVE[flatpak]:-0}" != "1" ]]; then
        FLATPAK_SYSTEM_TRANSACTION_STATUS="unavailable"
        FLATPAK_USER_TRANSACTION_STATUS="unavailable"
        info "Flatpak is not installed; Flatpak maintenance is skipped."
        return
    fi

    update_flatpak_scope "--system" "system" "$FLATPAK_SYSTEM_HAS_REFS" \
        FLATPAK_SYSTEM_TRANSACTION_STATUS
    update_flatpak_scope "--user" "user" "$FLATPAK_USER_HAS_REFS" \
        FLATPAK_USER_TRANSACTION_STATUS
}

