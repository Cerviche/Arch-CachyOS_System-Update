# Check for unread Arch Linux news using Informant
check_arch_news() {
    section "Arch Linux news"

    local news_file="$TEMP_DIR/informant-unread.txt"
    local news_error="$TEMP_DIR/informant-unread.err"
    local rc=0
    local count=0

    if [[ "${HAVE[informant]:-0}" != "1" ]]; then
        UNREAD_NEWS_COUNT="unavailable"
        info "Informant is not installed; Arch news integration is unavailable."
        return
    fi

    : > "$news_file"
    : > "$news_error"

    sudo -n informant list --unread > "$news_file" 2> "$news_error" || rc=$?
    if (( rc != 0 )); then
        warn "informant.check" \
            "Informant could not check unread Arch Linux news; package updates are not blocked by this check alone."
        indent_file "$news_error"
        UNREAD_NEWS_COUNT="unavailable"
        return
    fi

    count=$(awk 'NF {count++} END {print count+0}' "$news_file")
    UNREAD_NEWS_COUNT=$count
    NEWS_CHECK_OK=1

    if (( count == 0 )); then
        ok "No unread Arch Linux news items were reported by Informant."
    else
        warn "informant.unread" "$count unread Arch Linux news item(s) were reported."
        indent_file "$news_file"
    fi
}

# Find Informant's pacman hooks
find_informant_hooks() {
    local hook
    local file

    pacman -Qlq informant 2>/dev/null |
        while IFS= read -r file; do
            [[ "$file" == /usr/share/libalpm/hooks/*.hook ]] || continue
            if grep -Eq '(^|[[:space:]])Exec[[:space:]]*=.*(/|[[:space:]])informant([[:space:]]|$)' "$file" 2>/dev/null; then
                printf '%s\n' "$file"
            fi
        done
}

# Temporarily disable Informant hooks to allow unattended updates
mask_informant_hooks() {
    local -a hooks=()
    local hook
    local base
    local override
    local backup
    local existed
    local target

    [[ "$MODE" == "update" ]] || return 0
    [[ "$UNREAD_NEWS_COUNT" =~ ^[0-9]+$ ]] || return 0
    (( UNREAD_NEWS_COUNT > 0 )) || return 0

    mapfile -t hooks < <(find_informant_hooks)
    if (( ${#hooks[@]} == 0 )); then
        warn "informant.hook.not_found" \
            "Informant is installed, but its package-owned pacman hook could not be identified."
        return 1
    fi

    if ! sudo -n install -d -m 755 -- "$INFORMANT_OVERRIDE_DIR"; then
        warn "informant.hook.directory" \
            "Unable to prepare the pacman hook override directory."
        return 1
    fi

    for hook in "${hooks[@]}"; do
        base=${hook##*/}
        override="${INFORMANT_OVERRIDE_DIR}/${base}"
        backup="${TEMP_DIR}/${base}.override-backup"
        existed=0

        # Skip if already disabled
        if [[ -L "$override" ]]; then
            target=$(readlink -- "$override" 2>/dev/null || true)
            if [[ "$target" == "/dev/null" ]]; then
                info "Informant hook is already disabled by an existing override: $override"
                continue
            fi
        fi

        # Backup existing override
        if sudo -n test -e "$override" || sudo -n test -L "$override"; then
            if ! sudo -n cp -a -- "$override" "$backup"; then
                warn "informant.hook.backup.${base}" \
                    "Unable to back up existing Informant hook override: $override"
                continue
            fi
            existed=1
        fi

        # Disable hook
        if ! sudo -n rm -f -- "$override" ||
            ! sudo -n ln -s /dev/null "$override"; then
            warn "informant.hook.mask.${base}" \
                "Unable to temporarily disable Informant hook: $override"
            if [[ "$existed" == "1" ]]; then
                sudo -n cp -a -- "$backup" "$override" >/dev/null 2>&1 || true
            fi
            continue
        fi

        # Track disabled hook for later restoration
        INFORMANT_OVERRIDE_PATHS+=("$override")
        INFORMANT_OVERRIDE_BACKUPS+=("$backup")
        INFORMANT_OVERRIDE_EXISTED+=("$existed")
        INFORMANT_OVERRIDE_ACTIVE+=("1")
        ok "Temporarily disabled package-owned Informant hook: $hook"
    done
}

# Discover repository updates using checkupdates
discover_repository_updates() {
    local output_file="$TEMP_DIR/repository-updates.txt"
    local error_file="$TEMP_DIR/repository-updates.err"
    local rc=0

    : > "$output_file"
    : > "$error_file"

    if [[ "${HAVE[checkupdates]:-0}" != "1" ]]; then
        REPO_UPDATES_COUNT="unavailable"
        warn "discovery.repository.unavailable" \
            "checkupdates is unavailable; repository update discovery is disabled. pacman-contrib provides it."
        return
    fi

    # Use isolated database to avoid interfering with package manager
    CHECKUPDATES_DB="$TEMP_DIR/checkupdates-db" TMPDIR="$TEMP_DIR" \
        checkupdates --nocolor > "$output_file" 2> "$error_file" || rc=$?

    case "$rc" in
        0)
            REPO_UPDATES_COUNT=$(count_nonempty_lines "$output_file")
            REPO_DISCOVERY_OK=1
            ;;
        2)
            REPO_UPDATES_COUNT=0
            REPO_DISCOVERY_OK=1
            ;;
        *)
            REPO_UPDATES_COUNT="unavailable"
            error "discovery.repository.failed" \
                "Repository update discovery failed."
            indent_file "$error_file"
            ;;
    esac

    if (( REPO_DISCOVERY_OK == 1 )); then
        info "Repository updates available: $REPO_UPDATES_COUNT"
    fi
}

# Discover AUR updates using yay
discover_aur_updates() {
    local output_file="$TEMP_DIR/aur-updates.txt"
    local error_file="$TEMP_DIR/aur-updates.err"
    local -a devel_args=()
    local rc=0

    : > "$output_file"
    : > "$error_file"

    if [[ "$AUR_CHECK_DEVEL" == "true" ]]; then
        devel_args=(--devel)
    else
        devel_args=(--devel=false)
    fi

    yay -Qua "${devel_args[@]}" >"$output_file" 2>"$error_file"
    rc=$?

    # yay returns 0 when updates are available, 1 when no updates
    if (( rc == 0 )); then
        AUR_UPDATES_COUNT=$(count_nonempty_lines "$output_file")
        AUR_DISCOVERY_OK=1
        info "AUR updates available: $AUR_UPDATES_COUNT"
    elif (( rc == 1 )) && [[ ! -s "$output_file" ]] && [[ ! -s "$error_file" ]]; then
        AUR_UPDATES_COUNT=0
        AUR_DISCOVERY_OK=1
        info "AUR updates available: 0"
    else
        AUR_UPDATES_COUNT="unavailable"
        error "discovery.aur.failed" \
            "AUR update discovery failed (exit status $rc)."
        [[ -s "$error_file" ]] && indent_file "$error_file"
    fi
}

# Check if Flatpak scope has any installed refs
flatpak_scope_has_refs() {
    local scope=$1
    local output_file=$2

    : > "$output_file"
    if flatpak list "$scope" --columns=application > "$output_file" \
        2> "${output_file}.err"; then
        [[ -s "$output_file" ]]
        return
    fi
    return 2
}

# Discover Flatpak updates for a specific scope
discover_flatpak_scope() {
    local scope=$1
    local label=$2
    local output_file=$3
    local has_refs_var=$4
    local count_var=$5
    local ok_var=$6
    local refs_file="${output_file}.refs"
    local rc=0
    local count=0

    : > "$output_file"

    if flatpak_scope_has_refs "$scope" "$refs_file"; then
        printf -v "$has_refs_var" '%s' "1"
    else
        rc=$?
        if (( rc == 1 )); then
            printf -v "$has_refs_var" '%s' "0"
            printf -v "$count_var" '%s' "0"
            printf -v "$ok_var" '%s' "1"
            info "No $label Flatpak refs are installed."
            return
        fi

        printf -v "$count_var" '%s' "unavailable"
        warn "flatpak.${label}.list" "Unable to inspect $label Flatpak refs."
        indent_file "${refs_file}.err"
        return
    fi

    if flatpak remote-ls "$scope" --updates --columns=application,name \
        > "$output_file" 2> "${output_file}.err"; then
        count=$(count_nonempty_lines "$output_file")
        printf -v "$count_var" '%s' "$count"
        printf -v "$ok_var" '%s' "1"
        info "$label Flatpak updates available: $count"
    else
        printf -v "$count_var" '%s' "unavailable"
        warn "flatpak.${label}.discovery" \
            "Unable to discover $label Flatpak updates."
        indent_file "${output_file}.err"
    fi
}

# Discover Flatpak updates across system and user scopes
discover_flatpak_updates() {
    if [[ "${HAVE[flatpak]:-0}" != "1" ]]; then
        FLATPAK_SYSTEM_UPDATES_COUNT="unavailable"
        FLATPAK_USER_UPDATES_COUNT="unavailable"
        info "Flatpak is not installed; skipping Flatpak discovery."
        return
    fi

    discover_flatpak_scope "--system" "system" "$TEMP_DIR/flatpak-system-updates.txt" \
        FLATPAK_SYSTEM_HAS_REFS FLATPAK_SYSTEM_UPDATES_COUNT FLATPAK_SYSTEM_DISCOVERY_OK
    discover_flatpak_scope "--user" "user" "$TEMP_DIR/flatpak-user-updates.txt" \
        FLATPAK_USER_HAS_REFS FLATPAK_USER_UPDATES_COUNT FLATPAK_USER_DISCOVERY_OK
}

# Discover all available updates
discover_updates() {
    section "Update discovery"

    discover_repository_updates
    discover_aur_updates
    discover_flatpak_updates
}

