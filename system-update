#!/usr/bin/env bash
#
# system-update - safety-focused CachyOS and Arch Linux update utility
#
# Intentional limitations:
# - Supports CachyOS and Arch Linux only.
# - Does not manage firmware or update BIOS/UEFI.
# - Does not manage Docker, pip, npm, cargo, gem, or ComfyUI.
# - Does not scrub filesystems or repair package databases automatically.
# - Does not create, remove, restore, or otherwise manage snapshots.
# - Does not alter bootloaders or restart services automatically.
# - Does not remove disabled service relics.
# - Does not resolve AUR conflicts automatically.
# - Cannot guarantee that every AUR package builds non-interactively.
# - Does not decide how pacnew, pacsave, or pacorig files should be merged.
# - Does not provide automatic rollback.
#
# The script intentionally avoids set -e. Every command whose failure matters is
# handled explicitly so expected non-zero results do not terminate the run.
#
set -u -o pipefail

# -----------------------------------------------------------------------------
# Constants and configuration
# -----------------------------------------------------------------------------

# Script identification
readonly SCRIPT_NAME="system-update"
readonly SCRIPT_VERSION="3.2.0"

# Storage thresholds (in MiB)
readonly ROOT_BLOCK_MIB=1024          # Minimum free space on / before blocking updates
readonly BOOT_WARN_MIB=200            # Warning threshold for /boot free space
readonly BOOT_BLOCK_MIB=100           # Blocking threshold for /boot free space

# Pacman paths
readonly PACMAN_CONF="/etc/pacman.conf"
readonly PACMAN_LOCK="/var/lib/pacman/db.lck"
readonly PACMAN_DB_DIR="/var/lib/pacman"
readonly PACMAN_CACHE_DIR="/var/cache/pacman/pkg"

# Informant (Arch Linux news) configuration
readonly INFORMANT_OVERRIDE_DIR="/etc/pacman.d/hooks"

# AUR development package checking (disabled by default to avoid unwanted rebuilds)
readonly AUR_CHECK_DEVEL="false"

# Visual separator for output sections
readonly SEPARATOR="------------------------------------------------------------------------"

# -----------------------------------------------------------------------------
# Global state variables
# -----------------------------------------------------------------------------

# Runtime mode (update, audit, plan, help, version)
MODE="update"

# Timestamp for duration calculation
START_EPOCH=0

# Temporary directory for all script artifacts
TEMP_DIR=""

# Lock file configuration
LOCK_FILE=""
LOCK_FD=""

# Sudo credential keepalive process
SUDO_KEEPALIVE_PID=""

# Cleanup tracking to prevent duplicate cleanup
CLEANUP_STARTED=0

# Output formatting (color support)
USE_COLOR=0
C_RESET=""
C_OK=""
C_INFO=""
C_WARN=""
C_FAIL=""

# Audit and safety tracking
BLOCKING_FAILURES=0
REQUIRED_MISSING=0

# Kernel tracking
RUNNING_KERNEL=""
RUNNING_MODULE_DIR=""
RUNNING_KERNEL_PACKAGE=""
RUNNING_KERNEL_VERSION_BEFORE=""
RUNNING_KERNEL_VERSION_AFTER=""
REBOOT_REQUIRED="no"

# Update discovery counters
REPO_UPDATES_COUNT="unavailable"
AUR_UPDATES_COUNT="unavailable"
FLATPAK_SYSTEM_UPDATES_COUNT="unavailable"
FLATPAK_USER_UPDATES_COUNT="unavailable"

# Discovery success flags
REPO_DISCOVERY_OK=0
AUR_DISCOVERY_OK=0
FLATPAK_SYSTEM_DISCOVERY_OK=0
FLATPAK_USER_DISCOVERY_OK=0

# Transaction status tracking
REPO_TRANSACTION_STATUS="not run"
AUR_TRANSACTION_STATUS="not run"
FLATPAK_SYSTEM_TRANSACTION_STATUS="not run"
FLATPAK_USER_TRANSACTION_STATUS="not run"

# Flatpak state
FLATPAK_SYSTEM_HAS_REFS=0
FLATPAK_USER_HAS_REFS=0

# Configuration file tracking
CONFIG_HIGH_COUNT=0          # High-priority config files needing review
CONFIG_TOTAL_COUNT=0         # Total config files needing review
RELEVANT_FAILED_COUNT=0      # Important systemd units that failed
IGNORED_FAILED_COUNT=0       # Disabled/stale systemd units that failed

# Arch Linux news tracking
UNREAD_NEWS_COUNT="unavailable"

# Orphan package tracking
ORPHANS_FOUND=0
ORPHANS_REMOVED=0
ORPHAN_REMOVAL_DECLINED="no"

# News reading state
NEWS_CHECK_OK=0
NEWS_READ_DECLINED="no"

# Message collections for summary
declare -a WARNING_MESSAGES=()
declare -a ERROR_MESSAGES=()
declare -A WARNING_SEEN=()
declare -A ERROR_SEEN=()
declare -A BLOCKING_SEEN=()
declare -A HAVE=()

# Repository and service state arrays
declare -a ENABLED_REPOS=()
declare -a CONFIG_HIGH_FILES=()
declare -a CONFIG_NORMAL_FILES=()
declare -a RELEVANT_FAILED_UNITS=()
declare -a IGNORED_FAILED_UNITS=()

# Informant hook management
declare -a INFORMANT_OVERRIDE_PATHS=()
declare -a INFORMANT_OVERRIDE_BACKUPS=()
declare -a INFORMANT_OVERRIDE_EXISTED=()
declare -a INFORMANT_OVERRIDE_ACTIVE=()

# -----------------------------------------------------------------------------
# Helper functions
# -----------------------------------------------------------------------------

# Display usage information
usage() {
    cat <<'EOF'
Usage:
  system-update
  system-update --audit
  system-update --plan
  system-update --help
  system-update --version

Modes:
  no option   Audit, discover, and safely apply system updates.
  --audit     Run read-only health and configuration checks.
  --plan      Audit and list pending repository, AUR, and Flatpak updates.
  --help      Show this help.
  --version   Show the installed script version.
EOF
}

# Display version information
version() {
    printf '%s %s\n' "$SCRIPT_NAME" "$SCRIPT_VERSION"
}

# Parse command-line arguments and set MODE accordingly
parse_args() {
    if (( $# == 0 )); then
        MODE="update"
        return 0
    fi

    if (( $# != 1 )); then
        printf '[FAIL] Exactly one mode option may be supplied.\n' >&2
        usage >&2
        return 2
    fi

    case "$1" in
        --audit)
            MODE="audit"
            ;;
        --plan)
            MODE="plan"
            ;;
        --help)
            MODE="help"
            ;;
        --version)
            MODE="version"
            ;;
        *)
            printf '[FAIL] Unknown option: %s\n' "$1" >&2
            usage >&2
            return 2
            ;;
    esac
}

# Initialize output formatting with color support detection
init_output() {
    if [[ -t 1 && "${TERM:-dumb}" != "dumb" ]]; then
        USE_COLOR=1
        C_RESET=$'\033[0m'
        C_OK=$'\033[32m'
        C_INFO=$'\033[36m'
        C_WARN=$'\033[33m'
        C_FAIL=$'\033[31m'
    fi
}

# Print a status message with optional color
status() {
    local label=$1
    shift
    local message=$*
    local color=""

    if (( USE_COLOR == 1 )); then
        case "$label" in
            OK) color=$C_OK ;;
            INFO) color=$C_INFO ;;
            WARN) color=$C_WARN ;;
            FAIL) color=$C_FAIL ;;
        esac
    fi

    if (( USE_COLOR == 1 )); then
        printf '%b[%s]%b %s\n' "$color" "$label" "$C_RESET" "$message"
    else
        printf '[%s] %s\n' "$label" "$message"
    fi
}

# Print a section header with separators
section() {
    printf '\n%s\n%s\n%s\n' "$SEPARATOR" "$1" "$SEPARATOR"
}

# Record a warning message (deduplicated by ID)
record_warning() {
    local id=$1
    shift
    local message=$*

    if [[ -z "${WARNING_SEEN[$id]+x}" ]]; then
        WARNING_SEEN["$id"]=1
        WARNING_MESSAGES+=("$message")
    fi
}

# Record an error message (deduplicated by ID)
record_error() {
    local id=$1
    shift
    local message=$*

    if [[ -z "${ERROR_SEEN[$id]+x}" ]]; then
        ERROR_SEEN["$id"]=1
        ERROR_MESSAGES+=("$message")
    fi
}

# Convenience functions for common status types
ok() {
    status "OK" "$*"
}

info() {
    status "INFO" "$*"
}

warn() {
    local id=$1
    shift
    local message=$*
    record_warning "$id" "$message"
    status "WARN" "$message"
}

error() {
    local id=$1
    shift
    local message=$*
    record_error "$id" "$message"
    status "FAIL" "$message"
}

# Record and display a blocking error (prevents updates)
blocking_error() {
    local id=$1
    shift
    local message=$*

    if [[ -z "${BLOCKING_SEEN[$id]+x}" ]]; then
        BLOCKING_SEEN["$id"]=1
        (( BLOCKING_FAILURES += 1 ))
    fi
    error "$id" "$message"
}

# Indent file content by 4 spaces (for cleaner output)
indent_file() {
    local file=$1
    if [[ -s "$file" ]]; then
        sed 's/^/    /' "$file"
    fi
}

# Count non-empty lines in a file
count_nonempty_lines() {
    local file=$1
    awk 'NF {count++} END {print count+0}' "$file"
}

# Get the system hostname using available tools
get_hostname() {
    local name=""

    if command -v hostnamectl >/dev/null 2>&1; then
        name=$(hostnamectl --static 2>/dev/null || true)
    fi
    if [[ -z "$name" ]] && command -v hostname >/dev/null 2>&1; then
        name=$(hostname 2>/dev/null || true)
    fi
    if [[ -z "$name" ]]; then
        name="unknown"
    fi
    printf '%s\n' "$name"
}

# Print script header with version and hostname
print_header() {
    printf '%s %s\n' "$SCRIPT_NAME" "$SCRIPT_VERSION"
    printf 'Host: %s\n' "$(get_hostname)"
    printf 'Mode: %s\n' "$MODE"
}

# -----------------------------------------------------------------------------
# Locking and cleanup functions
# -----------------------------------------------------------------------------

# Acquire a process lock to prevent concurrent runs
acquire_lock() {
    local lock_dir="${XDG_RUNTIME_DIR:-/tmp}"

    if [[ ! -d "$lock_dir" || ! -w "$lock_dir" ]]; then
        lock_dir="/tmp"
    fi

    LOCK_FILE="${lock_dir}/${SCRIPT_NAME}-${UID}.lock"
    if ! exec {LOCK_FD}>"$LOCK_FILE"; then
        printf '[FAIL] Unable to open lock file: %s\n' "$LOCK_FILE" >&2
        return 1
    fi
    if ! flock -n "$LOCK_FD"; then
        printf '[FAIL] Another %s process is already running.\n' "$SCRIPT_NAME" >&2
        return 1
    fi
}

# Create a secure temporary directory
create_temp_dir() {
    TEMP_DIR=$(mktemp -d -t "${SCRIPT_NAME}.XXXXXXXX")
    if [[ -z "$TEMP_DIR" || ! -d "$TEMP_DIR" ]]; then
        printf '[FAIL] Unable to create a temporary directory.\n' >&2
        return 1
    fi
}

# Restore disabled Informant hooks to their original state
restore_informant_hooks() {
    local quiet=${1:-no}
    local failed=0
    local i
    local override
    local backup
    local existed

    for (( i=${#INFORMANT_OVERRIDE_PATHS[@]}-1; i>=0; i-- )); do
        [[ "${INFORMANT_OVERRIDE_ACTIVE[$i]}" == "1" ]] || continue

        override=${INFORMANT_OVERRIDE_PATHS[$i]}
        backup=${INFORMANT_OVERRIDE_BACKUPS[$i]}
        existed=${INFORMANT_OVERRIDE_EXISTED[$i]}

        if ! sudo -n rm -f -- "$override" >/dev/null 2>&1; then
            failed=1
            continue
        fi

        if [[ "$existed" == "1" ]]; then
            if ! sudo -n cp -a -- "$backup" "$override" >/dev/null 2>&1; then
                failed=1
                continue
            fi
        fi

        INFORMANT_OVERRIDE_ACTIVE[$i]=0
        if [[ "$quiet" != "yes" ]]; then
            ok "Restored Informant hook override: $override"
        fi
    done

    return "$failed"
}

# Clean up resources on script exit
cleanup() {
    local exit_code=$?
    local restore_failed=0

    if (( CLEANUP_STARTED == 1 )); then
        return
    fi
    CLEANUP_STARTED=1
    trap - EXIT INT TERM HUP

    # Restore Informant hooks
    if ! restore_informant_hooks "yes"; then
        restore_failed=1
        printf '[FAIL] Emergency cleanup could not restore every Informant hook override.\n' >&2
        printf '[FAIL] Inspect %s and preserve the temporary backups under %s.\n' \
            "$INFORMANT_OVERRIDE_DIR" "${TEMP_DIR:-unknown}" >&2
        if (( exit_code == 0 )); then
            exit_code=1
        fi
    fi

    # Kill sudo keepalive process
    if [[ -n "$SUDO_KEEPALIVE_PID" ]]; then
        kill "$SUDO_KEEPALIVE_PID" >/dev/null 2>&1 || true
        wait "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
    fi

    # Clean up temporary directory
    if (( restore_failed == 0 )) && [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
        if command -v sudo >/dev/null 2>&1; then
            sudo -n rm -rf -- "$TEMP_DIR" >/dev/null 2>&1 || rm -rf -- "$TEMP_DIR"
        else
            rm -rf -- "$TEMP_DIR"
        fi
    fi

    exit "$exit_code"
}

# Install signal traps for clean cleanup
install_traps() {
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
}

# -----------------------------------------------------------------------------
# Authorization functions
# -----------------------------------------------------------------------------

# Acquire sudo credentials and maintain them
authorize_sudo() {
    section "Authorisation"

    if ! command -v sudo >/dev/null 2>&1; then
        blocking_error "dependency.sudo" "Required command is missing: sudo"
        return 1
    fi

    info "Requesting initial sudo authentication."
    if ! sudo -v; then
        blocking_error "sudo.authentication" "Sudo authentication failed."
        return 1
    fi

    # Spawn background process to keep sudo credentials alive
    (
        # Release the lock file descriptor to avoid holding it in child
        exec {LOCK_FD}>&-
        while true; do
            sleep 50
            sudo -n true >/dev/null 2>&1 || exit 0
        done
    ) &
    SUDO_KEEPALIVE_PID=$!

    ok "Sudo authentication acquired; credential keepalive started."
}

# -----------------------------------------------------------------------------
# Audit and discovery functions
# -----------------------------------------------------------------------------

# Check for required and optional dependencies
audit_dependencies() {
    section "Dependencies"

    local -a required=(
        bash pacman sudo yay flock awk grep sed findmnt df getent systemctl
    )
    local -a optional=(
        pacman-conf checkupdates paccache pacdiff flatpak informant snapper shellcheck
    )
    local command_name

    # Check required commands
    for command_name in "${required[@]}"; do
        if command -v "$command_name" >/dev/null 2>&1; then
            HAVE["$command_name"]=1
        else
            HAVE["$command_name"]=0
            REQUIRED_MISSING=1
            blocking_error "dependency.${command_name}" \
                "Required command is missing: $command_name"
        fi
    done

    # Check hostname commands
    if command -v hostname >/dev/null 2>&1; then
        HAVE["hostname"]=1
    else
        HAVE["hostname"]=0
    fi
    if command -v hostnamectl >/dev/null 2>&1; then
        HAVE["hostnamectl"]=1
    else
        HAVE["hostnamectl"]=0
    fi
    if [[ "${HAVE[hostname]}" == "0" && "${HAVE[hostnamectl]}" == "0" ]]; then
        REQUIRED_MISSING=1
        blocking_error "dependency.hostname" \
            "A required host-name command is missing: install hostname or provide hostnamectl."
    fi

    # Report optional commands
    for command_name in "${optional[@]}"; do
        if command -v "$command_name" >/dev/null 2>&1; then
            HAVE["$command_name"]=1
        else
            HAVE["$command_name"]=0
            info "Optional command unavailable: $command_name"
        fi
    done

    if (( REQUIRED_MISSING == 0 )); then
        ok "All required commands are available."
    fi
}

# Check for pacman database lock
check_pacman_lock() {
    local context=${1:-audit}

    if [[ -e "$PACMAN_LOCK" ]]; then
        blocking_error "pacman.lock.${context}" \
            "Pacman lock exists at $PACMAN_LOCK; it will not be deleted."
        return 1
    fi

    ok "No pacman database lock is present."
}

# Load enabled repositories from pacman configuration
load_enabled_repositories() {
    local repo_file="$TEMP_DIR/enabled-repositories.txt"
    local listing_file="$TEMP_DIR/repository-listing.txt"
    local error_file="$TEMP_DIR/repository-listing.err"
    local repo

    : > "$repo_file"
    : > "$listing_file"
    : > "$error_file"

    # Try pacman-conf first
    if [[ "${HAVE[pacman-conf]:-0}" == "1" ]]; then
        if pacman-conf --repo-list > "$repo_file" 2> "$TEMP_DIR/pacman-conf.err"; then
            ok "Enabled repositories parsed with pacman-conf."
        else
            blocking_error "repo.parse" "pacman-conf could not parse enabled repositories."
            indent_file "$TEMP_DIR/pacman-conf.err"
            return 1
        fi
    else
        warn "repo.parse.fallback" \
            "pacman-conf is unavailable; repository names will be derived from pacman output."
    fi

    # Get repository database listing
    if ! pacman -Sl > "$listing_file" 2> "$error_file"; then
        blocking_error "repo.databases" "Enabled repository databases are not usable."
        indent_file "$error_file"
        return 1
    fi

    # Extract repository names
    if [[ ! -s "$repo_file" ]]; then
        awk 'NF && !seen[$1]++ {print $1}' "$listing_file" > "$repo_file"
    fi

    mapfile -t ENABLED_REPOS < <(awk 'NF {print $1}' "$repo_file")
    if (( ${#ENABLED_REPOS[@]} == 0 )); then
        blocking_error "repo.none" "No enabled repositories could be identified."
        return 1
    fi

    info "Enabled repositories:"
    for repo in "${ENABLED_REPOS[@]}"; do
        printf '    %s\n' "$repo"
    done
    ok "Repository databases are readable."
}

# Check if a specific repository is enabled
repository_is_enabled() {
    local wanted=$1
    local repo

    for repo in "${ENABLED_REPOS[@]}"; do
        if [[ "$repo" == "$wanted" ]]; then
            return 0
        fi
    done
    return 1
}

# Check for CachyOS repository presence
has_cachyos_repository() {
    local repo

    for repo in "${ENABLED_REPOS[@]}"; do
        if [[ "$repo" == cachyos || "$repo" == cachyos-* ]]; then
            return 0
        fi
    done
    return 1
}

# Verify critical packages are available from enabled repositories
check_critical_packages() {
    local -a critical=(bash pacman glibc systemd)
    local package_name
    local error_file

    for package_name in "${critical[@]}"; do
        error_file="$TEMP_DIR/pacman-si-${package_name}.err"
        if pacman -Si -- "$package_name" >/dev/null 2> "$error_file"; then
            ok "Critical package resolves through enabled repositories: $package_name"
        else
            blocking_error "repo.critical.${package_name}" \
                "Critical package is unavailable from enabled repositories: $package_name"
            indent_file "$error_file"
        fi
    done
}

# Record running kernel information and check for updates
record_running_kernel() {
    local owner_file="$TEMP_DIR/running-kernel-owner.txt"
    local owner_error="$TEMP_DIR/running-kernel-owner.err"

    RUNNING_KERNEL=$(uname -r)
    RUNNING_MODULE_DIR="/usr/lib/modules/${RUNNING_KERNEL}"
    : > "$owner_file"
    : > "$owner_error"

    info "Running kernel: $RUNNING_KERNEL"
    info "Running kernel module directory: $RUNNING_MODULE_DIR"

    # Find package owning the running kernel
    if pacman -Qoq -- "$RUNNING_MODULE_DIR" > "$owner_file" 2> "$owner_error"; then
        RUNNING_KERNEL_PACKAGE=$(awk 'NF {print; exit}' "$owner_file")
    else
        RUNNING_KERNEL_PACKAGE=""
    fi

    if [[ -z "$RUNNING_KERNEL_PACKAGE" ]]; then
        if [[ "$RUNNING_KERNEL" == *cachyos* ]]; then
            blocking_error "kernel.owner" \
                "The running CachyOS kernel module directory has no installed package owner."
        else
            warn "kernel.owner" \
                "The running kernel module directory has no installed package owner."
        fi
        indent_file "$owner_error"
        return
    fi

    RUNNING_KERNEL_VERSION_BEFORE=$(
        pacman -Q -- "$RUNNING_KERNEL_PACKAGE" 2>/dev/null |
            awk 'NF >= 2 {print $2; exit}'
    )

    ok "Running kernel is owned by: $RUNNING_KERNEL_PACKAGE ${RUNNING_KERNEL_VERSION_BEFORE:-unknown}"

    # Additional checks for CachyOS kernel
    if [[ "$RUNNING_KERNEL" == *cachyos* ]]; then
        if pacman -Si -- "$RUNNING_KERNEL_PACKAGE" >/dev/null 2> "$TEMP_DIR/kernel-repo.err"; then
            ok "Running CachyOS kernel package resolves through enabled repositories."
        else
            blocking_error "kernel.repository" \
                "Running CachyOS kernel package is unavailable from enabled repositories: $RUNNING_KERNEL_PACKAGE"
            indent_file "$TEMP_DIR/kernel-repo.err"
        fi
    fi

    # Check if kernel module directory exists
    if [[ ! -d "$RUNNING_MODULE_DIR" ]]; then
        REBOOT_REQUIRED="yes"
        warn "kernel.modules.missing" \
            "The running kernel module directory is absent; a reboot is required."
    fi
}

# Verify CachyOS kernel packages are not foreign
check_cachyos_kernel_classification() {
    local installed_file="$TEMP_DIR/linux-cachyos-installed.txt"
    local package_name
    local foreign_found=0

    pacman -Qq | awk '/^linux-cachyos/ {print}' > "$installed_file"
    if [[ ! -s "$installed_file" ]]; then
        info "No installed package name begins with linux-cachyos."
        return
    fi

    while IFS= read -r package_name; do
        [[ -n "$package_name" ]] || continue
        if pacman -Qm -- "$package_name" >/dev/null 2>&1; then
            foreign_found=1
            blocking_error "kernel.foreign.${package_name}" \
                "Installed CachyOS kernel package is classified as foreign: $package_name"
        else
            ok "CachyOS kernel package is repository-managed: $package_name"
        fi
    done < "$installed_file"

    if (( foreign_found == 0 )); then
        ok "No installed linux-cachyos package is classified as foreign."
    fi
}

# Audit repository integrity and configuration
audit_repository_integrity() {
    section "Repository integrity"

    if [[ ! -f "$PACMAN_CONF" || ! -r "$PACMAN_CONF" ]]; then
        blocking_error "repo.pacman_conf" \
            "$PACMAN_CONF does not exist as a readable regular file."
        return
    fi
    ok "$PACMAN_CONF exists and is readable."

    if ! load_enabled_repositories; then
        return
    fi

    # Verify core repositories
    if repository_is_enabled "core"; then
        ok "Required repository is enabled: core"
    else
        blocking_error "repo.core" "Required repository is not enabled: core"
    fi

    if repository_is_enabled "extra"; then
        ok "Required repository is enabled: extra"
    else
        blocking_error "repo.extra" "Required repository is not enabled: extra"
    fi

    if has_cachyos_repository; then
        ok "At least one CachyOS repository is enabled."
    else
        blocking_error "repo.cachyos" "No CachyOS repository is enabled."
    fi

    check_critical_packages
    record_running_kernel
    check_cachyos_kernel_classification
}

# Audit pacman database integrity
audit_package_database() {
    section "Package database"

    local output_file="$TEMP_DIR/pacman-dk.out"
    local error_file="$TEMP_DIR/pacman-dk.err"

    if pacman -Dk > "$output_file" 2> "$error_file"; then
        ok "pacman -Dk completed successfully."
        if [[ -s "$output_file" ]]; then
            indent_file "$output_file"
        fi
    else
        blocking_error "pacman.database" "pacman -Dk reported database errors."
        indent_file "$output_file"
        indent_file "$error_file"
    fi
}

# Get available free space in MiB for a given path
available_mib() {
    local path=$1
    df -Pm -- "$path" 2>/dev/null | awk 'NR == 2 {print $4}'
}

# Audit network connectivity and storage availability
audit_network_and_storage() {
    section "Network and storage"

    local dns_file="$TEMP_DIR/dns.txt"
    local root_free=""
    local boot_target=""
    local boot_free=""
    local path

    # Check DNS resolution
    if getent ahosts archlinux.org > "$dns_file" 2> "$TEMP_DIR/dns.err" &&
        [[ -s "$dns_file" ]]; then
        ok "System resolver can resolve archlinux.org."
    else
        blocking_error "network.dns" \
            "The system resolver could not resolve archlinux.org."
        indent_file "$TEMP_DIR/dns.err"
    fi

    # Check root filesystem space
    root_free=$(available_mib "/")
    if [[ "$root_free" =~ ^[0-9]+$ ]]; then
        info "Free space on /: ${root_free} MiB"
        if (( root_free < ROOT_BLOCK_MIB )); then
            blocking_error "storage.root" \
                "Free space on / is below the ${ROOT_BLOCK_MIB} MiB blocking threshold."
        else
            ok "Root filesystem free space meets the blocking threshold."
        fi
    else
        blocking_error "storage.root.read" "Unable to determine free space on /."
    fi

    # Check /boot if it's a separate mount
    boot_target=$(findmnt -n -o TARGET --target /boot 2>/dev/null || true)
    if [[ "$boot_target" == "/boot" ]]; then
        boot_free=$(available_mib "/boot")
        if [[ "$boot_free" =~ ^[0-9]+$ ]]; then
            info "Free space on separately mounted /boot: ${boot_free} MiB"
            if (( boot_free < BOOT_BLOCK_MIB )); then
                blocking_error "storage.boot.block" \
                    "Free space on /boot is below the ${BOOT_BLOCK_MIB} MiB blocking threshold."
            elif (( boot_free < BOOT_WARN_MIB )); then
                warn "storage.boot.warn" \
                    "Free space on /boot is below the ${BOOT_WARN_MIB} MiB warning threshold."
            else
                ok "Separate /boot free space meets the warning threshold."
            fi
        else
            blocking_error "storage.boot.read" \
                "Unable to determine free space on separately mounted /boot."
        fi
    else
        info "/boot is not a separate mount; no separate /boot threshold applies."
    fi

    # Check write access for critical paths
    for path in "$PACMAN_DB_DIR" "$PACMAN_CACHE_DIR" "/etc"; do
        if [[ ! -e "$path" ]]; then
            blocking_error "storage.path.${path//\//_}" "Required path is absent: $path"
        elif sudo -n test -w "$path"; then
            ok "Root has write access to: $path"
        else
            blocking_error "storage.write.${path//\//_}" \
                "Root does not have write access to: $path"
        fi
    done

    if sudo -n test -w "$PACMAN_CONF"; then
        ok "Root has write access to $PACMAN_CONF."
    else
        warn "storage.pacman_conf.write" \
            "Root cannot write $PACMAN_CONF; package updates may still work, but configuration maintenance will not."
    fi
}

